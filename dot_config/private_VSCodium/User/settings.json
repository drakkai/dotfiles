{
  "window.restoreWindows": "none",
  "workbench.startupEditor": "none",
  "workbench.colorTheme": "One Dark Pro",
  "editor.fontFamily": "Source Code Pro Semibold, Consolas, 'Courier New', monospace",
  "editor.fontSize": 13,
  "workbench.iconTheme": "material-icon-theme",
  "files.associations": {
    "Podmanfile": "dockerfile",
    "*.ign": "json",
  },
  "[dockerfile]": {
    "editor.parameterHints.enabled": false,
    "editor.quickSuggestions": {
      "other": false,
      "comments": false,
      "strings": false,
    },
  },
  "vs-kubernetes": {
    "disable-linters": ["resource-limits"],
  },
  "editor.formatOnSave": true,
  "python.analysis.useImportHeuristic": true,
  "python.analysis.inlayHints.functionReturnTypes": true,
  "editor.semanticTokenColorCustomizations": {
    "[One Dark Pro]": {
      "rules": {
        "variable": "#ABB2BF", // One Dark Pro's default text color
        "variable.readonly": "#D19A66",
        "function.decorator:python": "#56b6c2",
        "class.decorator:python": "#56b6c2",
        "property:python": "#D19A66",
        // "property:python": {"foreground": "#d19a66"},
        "*.typeHint:python": "#ABB2BF",
        "property.declaration:python": "#D19A66",
        "parameter:python": { "fontStyle": "" },
      },
    },
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "punctuation.definition.string.begin",
          "punctuation.definition.string.end",
        ],
        "settings": {
          "foreground": "#74965d",
        },
      },
      {
        "scope": "keyword.operator",
        "settings": {
          "foreground": "#56b6c2",
        },
      },
    ],
  },
  "ruff.lint.ignore": ["E501"],
  "editor.renderControlCharacters": false,
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter-notebook",
  },
  "notebook.cellToolbarLocation": {
    "default": "right",
    "jupyter-notebook": "left",
  },
  "[helm]": {
    "editor.formatOnSave": false,
  },
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "redhat.telemetry.enabled": false,
  "ansible.lightspeed.enabled": false,
  "git.confirmSync": false,
  "security.workspace.trust.untrustedFiles": "open",
  "git.enableSmartCommit": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll": "explicit",
      "source.addMissingImports": "explicit",
    },
  },
  "gopls": {
    "ui.semanticTokens": true,
  },
  "go.useLanguageServer": true,
  "go.formatTool": "goimports",
  "[go]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
    },
  },
  "window.commandCenter": false,
  "git.ignoreRebaseWarning": true,
  "git.openRepositoryInParentFolders": "always",
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "http.systemCertificatesNode": true,
  "terminal.integrated.fontFamily": "UbuntuMono Nerd Font Mono",
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.fontLigatures.enabled": true,
  "files.autoSave": "onFocusChange",
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/__pycache__": true,
    "**/.venv": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/.coverage": true,
    "**/.vscode": true,
  },
  // "evenBetterToml.schema.associations": {
  //   "pyproject.toml": "https://json.schemastore.org/pyproject.json"
  // }
}
